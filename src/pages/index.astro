---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import FichaTecnica from "../components/FichaTecnica.astro";
import LaIdea from "../components/LaIdea.astro";
import Como from "../components/Como.astro";
import Casos from "../components/Casos.astro";
import Mariana from "../components/Mariana.astro";
import Cierre from "../components/Cierre.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFab from "../components/WhatsAppFab.astro";
// Orden del brief §4:
// Nav → Hero → FichaTecnica → LaIdea → Como → Casos → Mariana → Cierre → WhatsAppFab
---

<Base>
