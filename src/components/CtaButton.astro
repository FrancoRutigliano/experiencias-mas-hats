---
/**
 * El único botón de CTA del sitio: «Pedir propuesta» → WhatsApp con el
 * mensaje pre-cargado. Mismo texto y mismo aspecto en todos lados; sólo cambia
 * el `origen` (spec §5).
 *
 * Contraste (WCAG 2.x):
 *   reposo  --mh-tinta sobre --mh-trigo       7.78:1
 *   hover   --mh-cal   sobre --mh-trigo-dark  9.30:1
 *   activo  --mh-cal   sobre --mh-trigo-ink   6.19:1
 *
 * El color del anillo de foco se hereda de `--foco` (lo define el bloque que
 * contiene el botón: sobre foto oscura, --mh-eyebrow; sobre cal, el default
 * --mh-trigo-ink). Así el botón no necesita variantes.
 */
import { experiencia } from "../data/experiencia";
import { buildWhatsAppUrl, type Origen } from "../lib/whatsapp";

interface Props {
  origen: Origen;
  /**
   * Latido para llamar la atención (2026-09-25):
   * - "carga": tres latidos al cargar la página (≈4,5 s, menos de los 5 s
   *   que permite WCAG 2.2.2 sin control de pausa) y después quieto.
   * - "entrada": un latido ligado al scroll, cuando el botón entra en pantalla.
   * Además, todos laten una vez al pasar el mouse.
   */
  latido?: "carga" | "entrada";
}

const { origen, latido } = Astro.props;
const href = buildWhatsAppUrl(origen, experiencia.whatsapp);
---

<a class:list={["cta", latido && `cta--latido-${latido}`]} href={href} target="_blank" rel="noopener" data-origen={origen}>{experiencia.cta}</a>

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px; /* área táctil mínima */
    padding-inline: 1.75em;
    border-radius: var(--mh-radius);
    /* Hover: el tono oscuro se llena de izquierda a derecha. */
    background: linear-gradient(90deg, var(--mh-trigo-dark) 50%, var(--mh-trigo) 50%) 100% 0 / 201% 100%;
    color: var(--mh-tinta);
    font: var(--mh-p);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-position 0.55s var(--mh-ease-suave, ease),
      color 0.3s ease 0.12s;
  }

  .cta:hover {
    background-position: 0 0;
    color: var(--mh-cal);
  }

  .cta:active {
    background: var(--mh-trigo-ink);
    color: var(--mh-cal);
  }

  .cta:focus-visible {
    outline: 2px solid var(--foco, var(--mh-trigo-ink));
    outline-offset: 3px;
  }
</style>
