    92.5% { transform: rotate(0deg); }
    93.75% { transform: rotate(-16deg); }
    95.0% { transform: rotate(0deg); }
    96.25% { transform: rotate(-16deg); }
    97.5% { transform: rotate(0deg); }
    98.75% { transform: rotate(-16deg); }
    100.0% { transform: rotate(0deg); }
  }
</style>
