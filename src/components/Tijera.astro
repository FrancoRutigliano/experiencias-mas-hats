---
/**
 * Tijera lateral (2026-09-25): indicador de avance con el lenguaje de la
 * marca. En el margen derecho corre una costura vertical; la tijera baja por
 * ella a medida que se scrollea y, por detrás, la costura queda abierta.
 *
 * - Sólo desktop (≥ 1200 px), dentro del margen: nunca tapa texto.
 * - Se mueve SÓLO con el scroll (scroll-driven animations): quieta no hace
 *   nada, así que no necesita pausa (WCAG 2.2.2). Las hojas abren y cierran
 *   ligadas al avance, no a un reloj.
 * - Aparece recién al salir del hero (sobre la foto oscura no se leería).
 * - Sin soporte o con «reducir movimiento», no se muestra. Decorativa.
 */
---

<div class="tijera" aria-hidden="true">
  <span class="tijera__costura"></span>
  <span class="tijera__corte"></span>
  <svg class="tijera__icono" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="6" cy="6" r="3"></circle>
    <circle cx="6" cy="18" r="3"></circle>
    <path class="tijera__hoja" d="M20 4 8.12 15.88"></path>
    <path d="M14.47 14.48 20 20M8.12 8.12 12 12"></path>
  </svg>
</div>

<style>
  .tijera {
    display: none;
  }

  @media (min-width: 1200px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .tijera {
        --linea-tijera: scroll(root);
        --tinta-costura: rgba(35, 42, 38, 0.45);
        position: fixed;
        top: 16vh;
        bottom: 16vh;
        right: 26px;
        z-index: 40;
        display: block;
        width: 24px;
        pointer-events: none;
        opacity: 0;
        animation-name: mh-tijera-aparece;
        animation-duration: 1ms;
        animation-fill-mode: both;
        animation-timing-function: linear;
        animation-timeline: var(--linea-tijera);
        animation-range: var(--rango-aparece, 60svh 100svh);
      }

      .tijera__costura,
      .tijera__corte,
      .tijera__icono {
        position: absolute;
        left: 50%;
        animation-duration: 1ms;
        animation-fill-mode: both;
        animation-timing-function: linear;
        animation-timeline: var(--linea-tijera);
      }

      /* Costura por delante de la tijera: se va «consumiendo» desde arriba. */
      .tijera__costura {
        inset-block: 0;
        width: 1.5px;
        translate: -50% 0;
        background: repeating-linear-gradient(to bottom, var(--tinta-costura) 0 8px, transparent 8px 14px);
        animation-name: mh-tijera-consume;
      }

      /* Por detrás, la costura abierta: dos filetes separados. */
      .tijera__corte {
        top: 0;
        height: 100%;
        width: 7px;
        translate: -50% 0;
        border-inline: 1px solid var(--tinta-costura);
        transform-origin: top;
        animation-name: mh-tijera-abre;
      }

      .tijera__icono {
        width: 24px;
        height: 24px;
        stroke: var(--mh-tinta);
        stroke-width: 1.4;
        background: var(--mh-cal);
        border-radius: 50%;
        translate: -50% -50%;
        rotate: 90deg;
        animation-name: mh-tijera-baja;
      }

      .tijera__hoja {
        transform-box: view-box;
        transform-origin: 12px 12px;
        animation: mh-tijeretazo 1ms linear both;
        animation-timeline: var(--linea-tijera);
      }
    }
  }

  @keyframes mh-tijera-aparece {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes mh-tijera-consume {
    from { clip-path: inset(0 0 0 0); }
    to { clip-path: inset(100% 0 0 0); }
  }

  @keyframes mh-tijera-abre {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }

  @keyframes mh-tijera-baja {
    from { top: 0%; }
    to { top: 100%; }
  }

  @keyframes mh-tijeretazo {
    0.0% { transform: rotate(0deg); }
    1.25% { transform: rotate(-16deg); }
    2.5% { transform: rotate(0deg); }
    3.75% { transform: rotate(-16deg); }
    5.0% { transform: rotate(0deg); }
    6.25% { transform: rotate(-16deg); }
    7.5% { transform: rotate(0deg); }
