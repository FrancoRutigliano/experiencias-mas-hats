---
/**
 * Tijera lateral (2026-09-25): recorrido de la página con el lenguaje de la
 * marca. En el margen derecho corre una costura vertical con una parada por
 * sección; la tijera baja por ella con el scroll y, por detrás, la costura
 * queda abierta. Cada parada es un link: al pasar el mouse o enfocarla
 * aparece su nombre en una etiqueta con moño.
 *
 * - Sólo desktop (≥ 1200 px), dentro del margen: nunca tapa texto.
 * - Las paradas se ubican donde empieza cada sección (script chico, abajo),
 *   así la tijera pasa por la parada justo al llegar a la sección. Sin JS
 *   quedan repartidas en partes iguales y siguen funcionando como links.
 * - La tijera se mueve SÓLO con el scroll: quieta no hace nada (WCAG 2.2.2).
 *   Con «reducir movimiento» o sin soporte, queda la costura con las paradas
 *   y no hay tijera.
 */
import { experiencia } from "../data/experiencia";

const paradas = experiencia.recorrido.filter(
  (parada) => parada.ancla !== "#casos" || experiencia.casos.publicar,
);
---

<nav class="tijera" aria-label="Recorrido de la página">
  <div class="tijera__pista" aria-hidden="true">
    <span class="tijera__costura"></span>
    <span class="tijera__corte"></span>
    <svg class="tijera__icono" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="6" cy="6" r="3"></circle>
      <circle cx="6" cy="18" r="3"></circle>
      <path class="tijera__hoja" d="M20 4 8.12 15.88"></path>
      <path d="M14.47 14.48 20 20M8.12 8.12 12 12"></path>
    </svg>
  </div>

  <ol class="tijera__paradas" role="list">
    {
      paradas.map((parada, i) => (
        <li class="tijera__parada" data-ancla={parada.ancla} style={`--pos: ${i / (paradas.length - 1)}`}>
          <a class="tijera__link" href={parada.ancla}>
            <span class="tijera__nombre">{parada.texto}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  // Ubica cada parada en la fracción de scroll donde empieza su sección
  // (menos el alto de la nav fija: el mismo scroll-padding-top de los anclas).
  const NAV_ALTO = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 72;

  function ubicarParadas(): void {
    const recorrible = document.documentElement.scrollHeight - innerHeight;
    if (recorrible <= 0) return;
    document.querySelectorAll<HTMLElement>(".tijera__parada").forEach((parada) => {
      const seccion = document.querySelector(parada.dataset.ancla ?? "");
      if (!seccion) return;
      const inicio = seccion.getBoundingClientRect().top + scrollY - NAV_ALTO;
      const pos = Math.min(1, Math.max(0, inicio / recorrible));
      parada.style.setProperty("--pos", pos.toFixed(4));
    });
  }

  ubicarParadas();
  addEventListener("load", ubicarParadas);
  new ResizeObserver(ubicarParadas).observe(document.body);
</script>

<style>
  .tijera {
    display: none;
  }

  @media (min-width: 1200px) {
    .tijera {
      --tinta-costura: rgba(35, 42, 38, 0.45);
      position: fixed;
      top: 16vh;
      bottom: 16vh;
      right: 26px;
      z-index: 40;
      display: block;
      width: 24px;
      pointer-events: none;
    }

    .tijera__pista,
    .tijera__paradas {
      position: absolute;
      inset: 0;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .tijera__costura,
    .tijera__corte,
    .tijera__icono {
      position: absolute;
      left: 50%;
    }

    .tijera__costura {
      inset-block: 0;
      width: 1.5px;
      translate: -50% 0;
      background: repeating-linear-gradient(to bottom, var(--tinta-costura) 0 8px, transparent 8px 14px);
    }

    .tijera__corte,
    .tijera__icono {
      display: none;
    }

    /* ---------- paradas ---------- */
    .tijera__parada {
      position: absolute;
      left: 50%;
      top: calc(var(--pos) * 100%);
      translate: -50% -50%;
    }

    .tijera__link {
      position: relative;
      display: grid;
      place-items: center;
      width: 24px;
      height: 24px;
      pointer-events: auto;
      text-decoration: none;
    }

    /* El nudo de la costura. */
    .tijera__link::before {
      content: "";
      width: 9px;
      height: 9px;
      border: 1.5px solid var(--mh-tinta);
      border-radius: 50%;
      background: var(--mh-cal);
      transition: background-color 0.2s ease, scale 0.2s ease;
    }

    .tijera__link:hover::before,
    .tijera__link:focus-visible::before {
      background: var(--mh-trigo);
      scale: 1.3;
    }

    .tijera__link:focus-visible {
      outline: 2px solid var(--mh-trigo-ink);
      outline-offset: 2px;
      border-radius: 50%;
    }

    /* Nombre en una etiqueta con moño, a la izquierda de la costura. */
    .tijera__nombre {
      position: absolute;
      right: calc(100% + 8px);
      top: 50%;
      padding: 0.7em 1em 0.7em 1.8em;
      background: var(--mh-tinta);
      color: var(--mh-cal);
      font: var(--mh-label);
      letter-spacing: var(--mh-label-ls);
      text-transform: uppercase;
      white-space: nowrap;
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, 0.8em 50%);
      opacity: 0;
      translate: 6px -50%;
      transition: opacity 0.2s ease, translate 0.25s var(--mh-ease, ease);
    }

    .tijera__link:hover .tijera__nombre,
    .tijera__link:focus-visible .tijera__nombre {
      opacity: 1;
      translate: 0 -50%;
    }
  }

  /* ---------- la tijera y el corte, ligados al scroll ---------- */
  @media (min-width: 1200px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .tijera__pista {
        --linea-tijera: scroll(root);
      }

      .tijera__costura,
      .tijera__corte,
      .tijera__icono,
      .tijera__hoja {
        animation-duration: 1ms;
        animation-fill-mode: both;
        animation-timing-function: linear;
        animation-timeline: var(--linea-tijera);
      }

      /* Por delante de la tijera, la costura se va «consumiendo». */
      .tijera__costura {
        animation-name: mh-tijera-consume;
      }

      /* Por detrás, la costura abierta: dos filetes separados. */
      .tijera__corte {
        display: block;
        top: 0;
        height: 100%;
        width: 7px;
        translate: -50% 0;
        border-inline: 1px solid var(--tinta-costura);
        transform-origin: top;
        animation-name: mh-tijera-abre;
      }

      .tijera__icono {
        display: block;
        z-index: 1;
        width: 24px;
        height: 24px;
        stroke: var(--mh-tinta);
        stroke-width: 1.4;
        background: var(--mh-cal);
        border-radius: 50%;
        translate: -50% -50%;
        rotate: 90deg;
        animation-name: mh-tijera-baja;
      }

      .tijera__hoja {
        transform-box: view-box;
        transform-origin: 12px 12px;
        animation-name: mh-tijeretazo;
      }
    }
  }

  @keyframes mh-tijera-consume {
    from { clip-path: inset(0 0 0 0); }
    to { clip-path: inset(100% 0 0 0); }
  }

  @keyframes mh-tijera-abre {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }

  @keyframes mh-tijera-baja {
    from { top: 0%; }
    to { top: 100%; }
  }

  @keyframes mh-tijeretazo {
    0.0% { transform: rotate(0deg); }
    1.25% { transform: rotate(-16deg); }
    2.5% { transform: rotate(0deg); }
    3.75% { transform: rotate(-16deg); }
    5.0% { transform: rotate(0deg); }
