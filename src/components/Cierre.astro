---
/**
 * 07 · Cierre (brief §4, spec §2). El footer vive aparte, en Footer.astro.
 *
 * - Desktop (≥ 900px): texto en 6 columnas, centrado en alto; la foto de
 *   detalle en las 5 últimas, a sangre contra el borde derecho y contra el
 *   borde superior e inferior del bloque. Sin marco: la foto es parte de la
 *   página, no una tarjeta.
 * - Mobile: texto y CTA primero (es lo que se viene a buscar al final), la
 *   foto después, a sangre de lado a lado.
 *
 * El bloque expone la línea de tiempo `--cierre` (view-timeline): la usa
 * WhatsAppFab para retirarse cuando aparece este CTA.
 *
 * Contraste sobre --mh-cal-2 (WCAG 2.x): --mh-tinta 12.54:1 · --mh-tinta-2
 * 6.71:1 · --mh-tinta-3 5.06:1 · --mh-trigo-ink 5.56:1 · hover
 * --mh-trigo-dark 8.35:1.
 */
import { Picture } from "astro:assets";
import CtaButton from "./CtaButton.astro";
import { experiencia } from "../data/experiencia";
import { fotos } from "../data/fotos";

const { titulo, bajada, foto } = experiencia.cierre;

const ANCHOS = [480, 800, 1200, 1600];
const SIZES = "(min-width: 900px) 42vw, 100vw";
---

<section id="cierre" class="cierre" aria-labelledby="cierre-titulo">
  <div class="contenedor grilla cierre__cuerpo">
    <div class="cierre__texto">
      <!-- Firma: sombrero de un solo trazo que se dibuja al entrar (decorativo). -->
      <svg class="cierre__sombrero" viewBox="0 0 200 120" fill="none" aria-hidden="true">
        <path pathLength="1" d="M10 88 C 40 72, 160 72, 190 88 C 160 101, 40 101, 10 88 Z" />
        <path pathLength="1" d="M54 84 C 50 52, 60 30, 100 26 C 140 30, 150 52, 146 84" />
        <path pathLength="1" d="M78 31 C 90 41, 110 41, 122 31" />
        <path pathLength="1" class="cierre__cinta" d="M53 72 C 80 78, 120 78, 147 72 M53 79 C 80 85, 120 85, 147 79" />
        <path pathLength="1" class="cierre__cinta" d="M142 76 C 156 58, 168 44, 180 30 M150 66 L 142 58 M156 58 L 149 49 M163 50 L 157 41 M154 64 L 164 62 M160 56 L 170 54 M166 48 L 175 46" />
      </svg>
      <h2 id="cierre-titulo" class="cierre__titulo">{titulo}</h2>
      <p class="cierre__bajada">{bajada}</p>
      <div class="cierre__accion">
        <CtaButton origen="cierre" latido="entrada" />
      </div>
    </div>

    <Picture
      src={fotos[foto.id]}
      alt={foto.alt}
      formats={["avif", "webp"]}
      widths={ANCHOS}
      sizes={SIZES}
      loading="lazy"
      decoding="async"
      class="cierre__foto"
      pictureAttributes={{ class: "cierre__picture marco" }}
    />
  </div>

</section>

<style>
  .cierre {
    view-timeline-name: --cierre;
    background: var(--mh-cal-2);
  }

  .cierre__cuerpo {
    row-gap: var(--mh-seccion);
    padding-top: var(--mh-seccion);
  }

  .cierre__texto {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .cierre__sombrero {
    width: clamp(120px, 14vw, 180px);
    height: auto;
    margin-bottom: clamp(20px, 3vw, 32px);
    stroke: var(--mh-tinta);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cierre__cinta {
    stroke: var(--mh-trigo-ink);
  }

  /* Se dibuja mientras el cierre entra en pantalla. Sin soporte o con
     «reducir movimiento», el sombrero está completo desde el principio. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .cierre__sombrero path {
        --linea-firma: view();
        --rango-firma: entry 10% cover 45%;
        stroke-dasharray: 1;
        animation-name: mh-trazo;
        animation-duration: 1ms;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: var(--linea-firma);
        animation-range: var(--rango-firma);
      }
    }
  }

  .cierre__titulo {
    color: var(--mh-tinta);
  }

  .cierre__bajada {
    margin-top: 1em;
    font: var(--mh-lead);
    color: var(--mh-tinta-2);
  }

  .cierre__accion {
    margin-top: 2rem;
  }

  /* Mobile: a sangre de lado a lado, recorte cuadrado sobre el sombrero. */
  .cierre__picture {
    grid-column: 1 / -1;
    max-width: none; /* global.css limita picture a 100%: acá sangra */
    margin-inline: calc(var(--mh-gutter) * -1);
  }

  .cierre__foto {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 60%;
  }

  @media (min-width: 900px) {
    .cierre__cuerpo {
      align-items: center;
      padding-top: 0;
    }

    .cierre__texto {
      grid-column: 1 / span 6;
      padding-block: var(--mh-seccion);
    }

    /* A sangre contra el borde derecho del viewport (también por encima de
       los 1440px del contenedor) y contra arriba y abajo del bloque. */
    .cierre__picture {
      --sangre: calc(var(--mh-gutter) + max(0px, (100vw - 1440px) / 2));
      grid-column: 8 / -1;
      margin-inline: 0 calc(var(--sangre) * -1);
    }

    .cierre__foto {
      aspect-ratio: 4 / 5;
      object-position: 50% 50%;
    }
  }
</style>
